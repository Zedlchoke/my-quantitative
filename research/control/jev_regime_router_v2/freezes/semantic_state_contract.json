{
 "bin_freeze_rationale": "domain-standard indicator conventions + synthetic fixtures, frozen BEFORE any historical call; no PnL consulted (V1 labels used ONLY to name UNKNOWN_COLLAPSE)",
 "bins": {
  "close_location": {
   "field": "clv_24",
   "labels": [
    "weak",
    "neutral",
    "strong"
   ],
   "thresholds": [
    0.4,
    0.6
   ]
  },
  "dist_to_ema": {
   "field": "dist_ema",
   "labels": [
    "extended_below",
    "below",
    "at",
    "above",
    "extended_above"
   ],
   "thresholds": [
    -1.5,
    -0.25,
    0.25,
    1.5
   ]
  },
  "drawdown_state": {
   "field": "dd_168",
   "labels": [
    "deep",
    "mild",
    "near_high"
   ],
   "note": "dd_168 <= -0.20 deep; -0.20..-0.05 mild; > -0.05 near_high",
   "thresholds": [
    -0.2,
    -0.05
   ]
  },
  "fast_trend": {
   "field": "ema_slope_fast",
   "labels": [
    "strong_down",
    "weak_down",
    "flat",
    "weak_up",
    "strong_up"
   ],
   "thresholds": [
    -0.002,
    -0.0003,
    0.0003,
    0.002
   ]
  },
  "prior_direction": {
   "from": "persisted effective regime",
   "map": {
    "ACCUMULATION": "DOWN",
    "DISTRIBUTION": "UP",
    "DOWNTREND": "DOWN",
    "TRANSITION_UNKNOWN": "NEUTRAL",
    "UPTREND": "UP",
    "null": "none"
   }
  },
  "prior_structure": {
   "from": "persisted effective regime",
   "map": {
    "ACCUMULATION": "RANGE",
    "DISTRIBUTION": "RANGE",
    "DOWNTREND": "TREND_DOWN",
    "TRANSITION_UNKNOWN": "RANGE",
    "UPTREND": "TREND_UP",
    "null": "none"
   }
  },
  "range_location": {
   "field": "range_pos",
   "labels": [
    "near_low",
    "middle",
    "near_high"
   ],
   "thresholds": [
    -0.3,
    0.3
   ]
  },
  "slow_trend": {
   "field": "ema_slope_slow",
   "labels": [
    "strong_down",
    "weak_down",
    "flat",
    "weak_up",
    "strong_up"
   ],
   "thresholds": [
    -0.0015,
    -0.0002,
    0.0002,
    0.0015
   ]
  },
  "trend_strength": {
   "field": "adx14",
   "labels": [
    "low",
    "medium",
    "high"
   ],
   "rationale": "Wilder-standard ADX conventions (20 trend / 30 strong trend)",
   "thresholds": [
    20,
    30
   ]
  },
  "volatility_regime": {
   "field": "rv_pctile",
   "labels": [
    "low",
    "normal",
    "high",
    "extreme"
   ],
   "rationale": "distribution quartiles of a trailing percentile",
   "thresholds": [
    0.25,
    0.75,
    0.9
   ]
  },
  "volume_state": {
   "field": "vol_z",
   "labels": [
    "low",
    "normal",
    "high"
   ],
   "thresholds": [
    -1,
    1
   ]
  }
 },
 "causality_law": "trailing-only windows; no centered/future normalization; same feature math as V1 f01..f16 (identical formulas); every field carries a name and a semantic bin",
 "raw_numerics_with_names": [
  "short_return(r4)",
  "medium_return(r24)",
  "long_return(r72)",
  "ema_slope_fast",
  "ema_slope_slow",
  "dist_ema",
  "adx14",
  "atr_pct",
  "rv_pctile",
  "dd_168",
  "dist_low",
  "range_pos",
  "vol_z",
  "clv_24"
 ],
 "schema": "jrv2_semantic_state_contract@1",
 "state_payload_law": {
  "forbidden": [
   "symbol",
   "absolute dates",
   "price levels",
   "calendar features",
   "event names",
   "PnL/outcomes"
  ],
  "state_id": "sha256('JRV2'||asset||data_sha||bar_ts)[:16]"
 },
 "warmup_regime_bars": 192
}
