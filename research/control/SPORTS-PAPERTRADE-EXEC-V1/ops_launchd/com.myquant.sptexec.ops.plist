<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPORTS-PAPERTRADE-EXEC-V1 durable paper-exec supervisor (ERRATUM_EXEC_5).
  PAPER ONLY (virtual cents). Binds the dashboard to 127.0.0.1:8791 ONLY.
  KeepAlive + RunAtLoad: survives reboot and restarts after a crash; the
  supervisor is crash-safe by design (all state re-derived from the
  append-only ledger + ops files; duplicate ledger rows are impossible by
  the chain laws). Install:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.myquant.sptexec.ops.plist
  Stop: launchctl bootout gui/$(id -u)/com.myquant.sptexec.ops
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.myquant.sptexec.ops</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/hoangminhlong/my-quantitative/.venv/bin/python</string>
    <string>-m</string>
    <string>research.papertrade_exec.ops_service</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/hoangminhlong/my-quantitative/.worktrees/sports-papertrade-exec-v1/integration</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/hoangminhlong/.my-quantitative-data/sports-papertrade-exec-v1/ops/logs/service.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/hoangminhlong/.my-quantitative-data/sports-papertrade-exec-v1/ops/logs/service.err.log</string>
</dict>
</plist>
