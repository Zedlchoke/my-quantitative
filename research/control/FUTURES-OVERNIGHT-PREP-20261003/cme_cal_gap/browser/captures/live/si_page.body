<div class="component title">
  <h2 id="features-and-benefits" class="title-text none None">
    
      Features and benefits
      
    
  </h2>
</div>


<div class="component row  big-gutters justify-content-start None ">
  <div class="col-md-6">

  
  
<div class="component title">
  <h4 id="more-transparency" class="title-text none crmb-1">
    
      More transparency
      
    
  </h4>
</div>
<div class="cmp cmp-text">
<div class="component react text">
  <div path="text">
    
      <p>Access a central point of price discovery, price transparency, risk management, mitigation of counterparty credit risk and CFTC oversight.</p>

    
  </div>
</div>

    


  



</div>

  

</div>
<div class="col-md-6">

  
  
<div class="component title">
  <h4 id="better-risk-management" class="title-text none crmb-1">
    
      Better risk management
      
    
  </h4>
</div>
<div class="cmp cmp-text">
<div class="component react text">
  <div path="text">
    
      <p>Benefit from electronic trading on CME Globex, facilitating risk management opportunities around the globe, and experience reduced credit risk through CME Clearing.</p>

    
  </div>
</div>

    


  



</div>

  

</div>

</div>

