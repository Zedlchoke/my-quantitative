  <div path="text">
    
      <h6><span class="th-dot closed"></span>closed</h6>
<p><span class="text4"><span class="text-averta-light">Final Close of the date. Day and GTD (current trade date) orders are eliminated.</span></span></p>

    
  </div>
</div>

    


  



</div>

  

</div>

</div>

  

</div>

</div>

  

</div>

</div>


