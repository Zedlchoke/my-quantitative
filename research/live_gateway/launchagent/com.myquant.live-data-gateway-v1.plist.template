<?xml version="1.0" encoding="UTF-8"?>
<!-- LIVE-DATA-GATEWAY-V1 LaunchAgent TEMPLATE — NOT INSTALLED.

Per plan §13: this file is a template only. It must NOT be copied into
~/Library/LaunchAgents without a future owner instruction. No sudo, no
login auto-start, and NO credentials ever belong in a plist (this
gateway is keyless public data only). Adjust ProgramArguments to the
absolute paths of your checkout before any (owner-authorized) use:
  1. <string>/Users/&lt;you&gt;/my-quantitative/.worktrees/live-data-gateway-v1/integration</string>
     is the working directory,
  2. run `.../.venv/bin/python -m research.live_gateway serve`.
Keep RunAtLoad=false until the owner says otherwise.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.myquant.live-data-gateway-v1</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/CHANGE_ME/my-quantitative/.venv/bin/python</string>
        <string>-m</string>
        <string>research.live_gateway</string>
        <string>serve</string>
        <string>--port</string>
        <string>8792</string>
        <string>--runtime-root</string>
        <string>results/live_data_gateway_v1</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/CHANGE_ME/my-quantitative/.worktrees/live-data-gateway-v1/integration</string>
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/tmp/live-data-gateway-v1.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/live-data-gateway-v1.err.log</string>
</dict>
</plist>
